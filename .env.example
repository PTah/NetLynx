# PostgreSQL (docker-compose по умолчанию — 127.0.0.1:5433, не в LAN).
# Пароль БД: POSTGRES_PASSWORD в окружении compose; в примере ниже только для локальной разработки.
DATABASE_URL=postgres://invetor:invetor@127.0.0.1:5433/invetor?sslmode=disable

# HTTP API + отдача веб-сборки (опционально)
HTTP_ADDR=:8080

# Как часто планировщик проверяет, какие коммутаторы пора опросить (секунды). Частота SNMP по каждому узлу задаётся в БД: poll_interval_seconds у устройства (10–86400).
POLL_SCHEDULER_SECONDS=10
# Порог «порт был без MAC столько часов», после чего появление MAC даёт событие ACCESS_PORT_LONG_IDLE_DEVICE (по умолчанию 72 ч = 3 суток).
ACCESS_PORT_LONG_IDLE_HOURS=72
# Отдельный интервал опроса FDB/MAC (секунды, обычно заметно реже)
FDB_POLL_INTERVAL_SECONDS=900
# Время "обучения" FDB после первого снимка (секунды): события по MAC не шлём, только строим baseline.
FDB_LEARN_SECONDS=1800
# Авто-эвристика trunk по FDB (для подавления ложных access-событий на аплинках):
# порт считается trunk, если на нём не меньше N MAC и они встречаются минимум в M VLAN.
FDB_AUTO_TRUNK_MIN_MACS=8
FDB_AUTO_TRUNK_MIN_VLANS=2
# Фолбэк для моделей без dot1qTpFdbPort (нет VLAN-разреза): trunk только по большому числу MAC.
FDB_AUTO_TRUNK_FALLBACK_MIN_MACS=12

# Порог утилизации порта (% от скорости линка)
PORT_UTIL_HIGH_PCT=90
PORT_UTIL_OK_PCT=85

# История метрик (CPU, утилизация) в PostgreSQL
METRICS_ENABLED=true
METRICS_RETENTION_DAYS=7

# Расследователь MAC: история перемещений FDB (сутки) и детект flapping.
# MAC_MOVES_RETENTION_DAYS=14
# MAC_FLAP_MIN_MOVES=3
# MAC_FLAP_WINDOW_SECONDS=3600
# MAC_FLAP_DEBOUNCE_SECONDS=900
# Опциональный UDP syslog для realtime %BRG_MACNTFY / MAC_FLAPPING (пусто = выкл).
# Пример: NETLYNX_SYSLOG_LISTEN=:9514
# На свитче: logging host <IP-NetLynx> udp port 9514 (или DNAT 514→9514).
# NETLYNX_SYSLOG_LISTEN=

# Broadcast storm heuristic (poller): ≥N ports above util % + FDB table growth on FDB poll.
# BROADCAST_STORM_MIN_PORTS=3
# BROADCAST_STORM_UTIL_PCT=80
# BROADCAST_STORM_FDB_MIN_GROWTH=5
# BROADCAST_STORM_FDB_MIN_GROWTH_PCT=2
# BROADCAST_STORM_DEBOUNCE_SECONDS=1800

# Ежедневные снимки FDB (история «где MAC был N дней назад»).
# FDB_SNAPSHOT_ENABLED=true
# FDB_SNAPSHOT_INTERVAL_HOURS=24
# FDB_SNAPSHOT_RETENTION_DAYS=30
# Авто-очистка live FDB (device_fdb_entries), если успешный FDB-опрос старше N дней (0 = выкл).
# FDB_STALE_CLEAR_DAYS=60

# История running-config (SSH snapshots + diff на карточке узла).
# CONFIG_SNAPSHOT_ENABLED=true
# CONFIG_SNAPSHOT_INTERVAL_HOURS=24
# CONFIG_SNAPSHOT_RETENTION_DAYS=90

# Каталог со сборкой веба (после «cd web && npm run build»). Если index.html найден —
# интерфейс открывается на том же порту, что и API (обычно http://127.0.0.1:8080).
# Укажите «-» чтобы не отдавать веб из Go (только API).
WEB_DIST=web/dist

# Публичный URL веб-интерфейса для ссылок в email-оповещениях (карточка устройства).
# Пример: http://10.0.0.1:8080
# NETLYNX_PUBLIC_URL=http://127.0.0.1:8080

# Auth обязателен: задайте пароль bootstrap-админа (создаётся только если пользователя ещё нет).
NETLYNX_ADMIN_USER=admin
NETLYNX_ADMIN_PASSWORD=change-me-to-a-long-secret
# Для lab без auth: NETLYNX_AUTH_DISABLED=true (несовместимо с паролем выше).
# NETLYNX_AUTH_DISABLED=false
#
# JWT: постоянный секрет хранится в БД (app_secrets). NETLYNX_JWT_SECRET — опциональный seed
# при первом запуске (≥32 символов). Если пусто — берётся legacy-derived от admin-пароля один раз,
# либо генерируется random. Смена admin-пароля больше не меняет подпись JWT.
# NETLYNX_JWT_SECRET=
# Secure-флаг refresh-cookie. По умолчанию true. Для plain HTTP (LAN без TLS) обязательно:
NETLYNX_COOKIE_SECURE=false
# Доверять X-Real-IP / X-Forwarded-For для IP в login rate-limit (только за своим reverse-proxy):
# NETLYNX_TRUST_PROXY=true
# Метрики Prometheus: GET /metrics (нужна роль viewer+).
# NETLYNX_ACCESS_TTL_SECONDS=900
# NETLYNX_REFRESH_TTL_SECONDS=604800

# Опциональный fallback для PoE через SSH CLI (Ubiquiti EdgeSwitch), если SNMP PoE-MIB недоступен.
# Включать только если понимаете риск хранения пароля в env.
# При SSH_POE_FALLBACK_ENABLED=true задайте SSH_POE_KNOWN_HOSTS (файл known_hosts с ключами свитчей).
# Без файла сервис стартует, но SSH PoE dial вернёт ошибку (InsecureIgnoreHostKey убран).
# SSH_POE_FALLBACK_ENABLED=false
# SSH_POE_KNOWN_HOSTS=/etc/netlynx/ssh_known_hosts
# SSH_POE_USER=ubnt
# SSH_POE_PASS=
# SSH_POE_ENABLE_PASS=
# SSH_POE_PORT=22
# SSH_POE_TIMEOUT_SECONDS=5

# Приём SNMP traps: порт и вкл/выкл — в UI (Настройки → Уведомления → Принимать traps), по умолчанию :9162.
# Env ниже — только фильтр community (опционально). SNMP_TRAP_LISTEN_ADDR больше не управляет listener.
# SNMP_TRAP_COMMUNITY=public
# На сервере при порте >1000: DNAT/REDIRECT UDP 162 → 9162 (для SNR и др.).
