[Unit]
Description=NetLynx SNMP monitoring service
# docker поднимает postgres (compose restart: unless-stopped); без After= возможна гонка → краткий restart-loop.
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
User=netlynx
Group=netlynx
WorkingDirectory=/opt/netlynx
EnvironmentFile=/etc/netlynx/netlynx.env
ExecStart=/usr/local/bin/netlynxd
Restart=always
RestartSec=3
# ICMP для «онлайн» (raw socket); нужен при NoNewPrivileges (иначе /usr/bin/ping без caps).
AmbientCapabilities=CAP_NET_RAW
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
